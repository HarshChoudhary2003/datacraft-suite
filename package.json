{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "preflight": "node scripts/preflight-imports.mjs",
    "dev": "node scripts/preflight-imports.mjs && vite dev",
    "build": "node scripts/preflight-imports.mjs && node scripts/lockfile-integrity.mjs && node scripts/gen-sbom.mjs --out reports/sbom.json && vite build",
    "build:dev": "node scripts/preflight-imports.mjs && vite build --mode development",
    "smoke:insights": "node scripts/smoke-insights.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "loadtest:gen": "node loadtest/gen_csv.mjs --rows 200000 --out loadtest/data/large.csv",
    "loadtest:ui": "node loadtest/ui_bench.mjs --rows 50000,200000,500000",
    "loadtest:report": "python loadtest/gen_report.py --rows 40000 --sweep 60000,150000,300000 --requests 12",
    "loadtest": "npm run loadtest:gen && node loadtest/ui_bench.mjs --file loadtest/data/large.csv",
    "lockfile:check": "node scripts/lockfile-integrity.mjs --json reports/lockfile.json",
    "sbom": "node scripts/gen-sbom.mjs --out reports/sbom.json",
    "audit:deps": "node scripts/dep-audit.mjs --level high --json reports/audit.json",
    "test:e2e": "playwright test",
    "smoke:e2e": "node scripts/smoke-e2e.mjs"
  },
