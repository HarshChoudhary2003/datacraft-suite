# -----------------------------------------------------------------------------
# DataCraft Suite Environment Template (.env.example)
# Copy this file to .env and replace placeholders with your actual values.
# NEVER commit your real .env file to version control.
# -----------------------------------------------------------------------------

# Supabase Configuration (Client & Server)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key-here"
VITE_SUPABASE_PROJECT_ID="your-project-id"

SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key-here"
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# AI / Insights Configuration (Optional)
OPENAI_API_KEY="your-openai-api-key-here"
LOVABLE_API_KEY="your-lovable-api-key-here"

# Backend FastAPI Service (Optional, for Python microservice)
VITE_API_URL="http://localhost:8000"
